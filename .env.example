# Client-Safe Environment Variables (Vite SPA - bundled into browser JS)
# ONLY publishable, client-safe variables belong here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_APP_ENV=development

# Server / Privileged Secrets (Backend scripts, Edge Functions, DB migrations only)
# NEVER prefix secrets with VITE_ or they will be exposed in client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJ...
